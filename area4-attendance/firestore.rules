rules_version = '2';

// Attendance is stored under: groups/{groupId}/attendance/{yyyy-MM-dd}
//
// Requires a signed-in user (Firebase Email/Password). Accounts are created by
// the admin in the Firebase console — there is no public sign-up — so "any
// authenticated user" is effectively "any admin you provisioned".
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupId}/attendance/{date} {
      allow read, write: if request.auth != null;
    }
  }
}

// ---------------------------------------------------------------------------
// Stricter option — restrict to an explicit allowlist of UIDs, in addition to
// requiring auth. Create an `allowedUsers/{uid}` doc per permitted account.
//
// service cloud.firestore {
//   match /databases/{database}/documents {
//     function isAllowed() {
//       return request.auth != null
//         && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid));
//     }
//     match /groups/{groupId}/attendance/{date} {
//       allow read, write: if isAllowed();
//     }
//     match /allowedUsers/{uid} { allow read: if request.auth != null; }
//   }
// }
