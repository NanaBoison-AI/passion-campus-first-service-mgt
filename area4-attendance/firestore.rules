rules_version = '2';

// Attendance is stored under: groups/{groupId}/attendance/{yyyy-MM-dd}
//
// ⚠️  DEFAULT (open) — quickest to get running, but ANY visitor with the app
//     URL can read/write attendance. Fine for a private pilot; NOT for real
//     data. Swap for the authenticated block below before going live.
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupId}/attendance/{date} {
      allow read, write: if true;
    }
  }
}

