# ---------------------------------------------------------------------------
# Copy to `.env` for local dev.  DO NOT commit `.env`.
# ---------------------------------------------------------------------------

# Apps Script Web App /exec URL (Sheets JSON API).
# Used by the Vite dev proxy locally, and by the Cloudflare Pages Function in
# production (set the same value as a Pages env var named SHEETS_API_URL).
SHEETS_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXX/exec

# Cloudflare Pages Function only (NOT prefixed VITE_): when set, the /api/sheets
# proxy requires a valid Firebase ID token before forwarding to Apps Script.
# Use the same value as VITE_FIREBASE_API_KEY. Leave unset to disable the check.
FIREBASE_API_KEY=

# ---- Firebase web config (safe to expose; these are not secrets) ----
# Firebase console → Project settings → Your apps → Web app → SDK config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Area label shown in the app header / used as a data scope.
VITE_AREA_LABEL=Area 4

# Usernames are mapped to `${username}@${VITE_AUTH_EMAIL_DOMAIN}` for Firebase
# Email/Password auth. Create accounts in the Firebase console using this domain
# (e.g. area4admin@area4.app). Users only ever type the username.
VITE_AUTH_EMAIL_DOMAIN=area4.app
